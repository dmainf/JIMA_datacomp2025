flowchart TB
    classDef io     fill:#f8fafc,stroke:#64748b,color:#0f172a
    classDef enc    fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef dec    fill:#dcfce7,stroke:#16a34a,color:#14532d

    x(["Input  x"])

    subgraph ENC["Encoder  (DoRA)"]
        inorm["Instance Norm"]
        patch["Patch Embed"]
        t5e["T5 Encoder"]
        inorm --> patch --> t5e
    end

    subgraph DEC["Decoder  (DoRA)"]
        t5d["T5 Decoder"]
        proj["Projection Head"]
        invn["Inv. Instance Norm"]
        t5d --> proj --> invn
    end

    x --> inorm
    patch -. "query" .-> t5d
    t5e -- "h" --> t5d
    invn --> y(["Quantile Forecasts  ŷ"])

    class x,y io
    class inorm,patch,t5e enc
    class t5d,proj,invn dec
