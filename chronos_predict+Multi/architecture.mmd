flowchart TB
    ctx["Local Context"]
    ret["Retrieved Series\n(FAISS top-K)"]

    subgraph LENC["Local Stream  [DoRA]"]
        enc_l["Encode(x)\nh_local"]
    end

    subgraph RENC["Retrieved Stream  [DoRA, shared weights]"]
        fold["Fold batch × K"]
        enc_r["Encode(retrieved)"]
        unfold["Unfold → h_raf"]
    end

    subgraph FUSE["Fusion  (no gate, no scale)"]
        concat["Concatenate\n[h_local ; h_raf]"]
    end

    subgraph DEC["Chronos Bolt Decoder  [DoRA]"]
        t5dec["T5 Decoder\ncross-attn to concatenated hidden"]
        outproj["Output Patch Projection"]
        invnorm["Inverse Instance Normalization"]
    end

    ctx --> enc_l
    ret --> fold --> enc_r --> unfold
    enc_l --> concat
    unfold --> concat
    concat -- "hidden_states" --> t5dec
    enc_l -. "input_embeds" .-> t5dec
    t5dec --> outproj --> invnorm --> out["Quantile Forecasts"]
