    end

    subgraph FUSE["Fusion  (no gate)"]
        concat["Concatenate\n[h_local ; h_raf_scaled]"]
    end

    subgraph DEC["Chronos Bolt Decoder  [DoRA]"]
        t5dec["T5 Decoder"]
        outproj["Output Patch Projection"]
